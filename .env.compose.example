# Salin menjadi .env di root hanya untuk docker compose lokal.
# PostgreSQL tetap berjalan di host, bukan sebagai container.
DOCKER_DB_URL=postgres://paymentreceipt:change-me@host.docker.internal:5432/paymentreceipt_v2?sslmode=disable
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
WEB_PORT=8088

# Opsional: fitur ekstraksi AI.
AI_BASE_URL=https://smartsproxy.clouad/v1
AI_API_KEY=
AI_MODEL_RECEIPT=gemini-3.8-flash-high
