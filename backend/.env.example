# Konfigurasi environment untuk Payment Receipt v2.
#
# Salin ke .env lalu sesuaikan:
#   cp .env.example .env
#
# JANGAN PERNAH commit .env yang berisi kredensial asli. File ini hanya template
# dan semua nilainya aman untuk disimpan di repo.

# --- Aplikasi -------------------------------------------------------------
APP_ENV=development
APP_NAME=paymentreceipt-v2
APP_BASE_URL=http://localhost:8080
# IP/CIDR proxy yang dipercaya untuk X-Forwarded-For, pisahkan dengan koma.
# Kosongkan kalau aplikasi diakses langsung tanpa proxy.
APP_TRUSTED_PROXIES=

# --- Server ---------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
# Batas ukuran body request dalam byte. Default 2 MiB.
SERVER_MAX_REQUEST_BODY=2097152

# --- Database -------------------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
# sslmode=disable HANYA untuk lokal. Production wajib require atau verify-full.
DB_URL=postgres://paymentreceipt:paymentreceipt_local@localhost:5432/paymentreceipt_v2?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s
# describe | prepare
DB_STATEMENT_CACHE_MODE=describe

# --- Auth -----------------------------------------------------------------
# WAJIB diganti di production. Minimal 32 byte.
# Generate dengan: openssl rand -base64 48
AUTH_JWT_SECRET=ganti-dengan-secret-acak-minimal-32-byte-di-sini
AUTH_ISSUER=paymentreceipt-v2
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h
AUTH_COOKIE_NAME=pr_access_token
AUTH_REFRESH_COOKIE_NAME=pr_refresh_token
# Kosongkan kalau diakses langsung tanpa domain (localhost).
AUTH_COOKIE_DOMAIN=
# WAJIB true di production. Kalau false, token bisa bocor lewat HTTP biasa.
AUTH_COOKIE_SECURE=false
# Lax | Strict | None (None wajib Secure=true)
AUTH_COOKIE_SAMESITE=Lax

# Argon2id - JANGAN turunkan di bawah nilai ini.
# Memory dalam KiB (19456 = 19 MiB, rekomendasi OWASP).
AUTH_ARGON2_MEMORY=19456
AUTH_ARGON2_TIME=2
AUTH_ARGON2_THREADS=1
AUTH_ARGON2_KEY_LEN=32
AUTH_ARGON2_SALT_LEN=16

# --- Logging --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# text (manusia) | json (produksi / agregator)
LOG_FORMAT=text

# --- AI (ekstraksi struk/faktur) ------------------------------------------
# BaseURL endpoint OpenAI-compatible. Default mengarah ke smartsproxy.clouad/v1.
# Model yang tersedia: gemini-3.8-flash-high, qwen/qwen3.8-omni-flash (context 200M+, exp 23.59)
AI_BASE_URL=https://smartsproxy.clouad/v1
# WAJIB diisi. Dapatkan dari penyedia AI (smartsproxy). JANGAN commit file .env asli.
AI_API_KEY=ganti-dengan-api-key-smartsproxy-anda
# Model default untuk ekstraksi struk/faktur.
AI_MODEL_RECEIPT=gemini-3.8-flash-high
# Timeout per permintaan ke AI.
AI_TIMEOUT=60s
# Batas ukuran file unggahan dalam byte (default 10 MiB).
AI_MAX_REQUEST_BODY=10485760