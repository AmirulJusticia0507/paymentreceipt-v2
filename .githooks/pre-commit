#!/usr/bin/env bash
# Pre-commit hook.
#
# Menjalankan pemeriksaan dasar sebelum commit dibuat. Tujuannya menangkap
# kelas masalah yang SUDAH benar-benar terjadi di repo ini, bukan menjadi
# gerbang yang memblokir setiap commit:
#
#   1. gofmt    — file Go yang staged harus sudah diformat.
#   2. secret   — tidak ada credential yang ikut ter-commit.
#   3. build    — backend harus terkompilasi (dua kali main sempat membawa
#                 commit yang build-nya rusak) dan lolos go vet.
#   4. types    — frontend harus lolos vue-tsc.
#
# `go test` sengaja dibiarkan untuk CI. Selain membuat hook jauh lebih lambat,
# test di mesin Windows ini bisa ditolak kebijakan Application Control yang
# memblokir binary hasil build - kegagalan yang acak. Hook yang gagal tanpa
# sebab kode akan di-bypass orang lewat --no-verify, dan hook yang di-bypass
# tidak melindungi apa pun. CI menjalankan test di ubuntu, di mana hasilnya
# deterministik, dan CI-lah yang menjadi keputusan akhir.
#
# Memakai hook ini: jalankan sekali per clone
#
#     git config core.hooksPath .githooks
#
# atau salin ke .git/hooks/pre-commit.

set -euo pipefail

root=$(git rev-parse --show-toplevel)

staged() {
  git diff --cached --name-only --diff-filter=ACM
}

# --- 1. gofmt -------------------------------------------------------------

staged_go=$(staged | grep '\.go$' || true)

if [ -n "$staged_go" ]; then
  unformatted=""
  for f in $staged_go; do
    [ -f "$f" ] || continue

    # PENTING: periksa versi STAGED (blob), bukan isi working tree.
    #
    # Pada Windows dengan `core.autocrlf=true`, file di working tree
    # memakai CRLF sementara git menyimpannya sebagai LF. `gofmt -l`
    # yang dibaca dari file akan melaporkan SELURUH file sebagai tidak
    # terformat - bukan karena salah format, hanya karena akhir baris.
    # Mengubah seluruh isi file tidak membetulkan itu.
    #
    # `git show :<path>` mengeluarkan blob staged (LF), yang memang
    # bentuk yang akan ter-commit, jadi penilaiannya adil.
    if ! git show ":$f" 2>/dev/null | gofmt -d 2>/dev/null | grep -q .; then
      continue
    fi
    unformatted="$unformatted$f
"
  done

  if [ -n "$unformatted" ]; then
    echo "gofmt: file berikut belum diformat:"
    printf '%s' "$unformatted" | sed 's/^/  /'
    echo ""
    echo "Jalankan: gofmt -w <file>"
    exit 1
  fi
fi

# --- 2. secret scan -------------------------------------------------------

# Pola credential nyata. Sengaja sempit: tiap pola tambahan adalah peluang
# false positive, dan orang akan belajar mengabaikan hook ini.
#
# Dikecualikan:
#   - .env.example  -> memang boleh berisi placeholder
#   - *_test.go     -> test memakai credential palsu secara sengaja
#   - docs/         -> dokumentasi menjelaskan nama variabel
#   - file biner
exclude_regex='(\.env\.example$|_test\.go$|^docs/|^\.github/workflows/)'

# AKIA + 16 karakter alfanumerik kapital = AWS access key ID.
aws_key='AKIA[0-9A-Z]{16}'
# Kunci privat apa pun.
private_key='-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----'
# Penugasan credential dengan nilai yang BUKAN placeholder.
#
# Huruf kecil dan besar sama-sama dicari: credential di file konfigurasi
# dan .env sering memakai huruf kecil (password=..., secret=...), dan
# pola yang hanya huruf besar akan melewatkan sebagian besar kasus nyata.
assignment='(PASSWORD|SECRET|API_KEY|APIKEY|TOKEN|AUTH_JWT_SECRET)[[:space:]]*=[[:space:]]*["'"'"'][^"'"'"']{8,}["'"'"']'

staged_files=$(staged | grep -vE "$exclude_regex" || true)

if [ -n "$staged_files" ]; then
  hits=$(printf '%s\n' "$staged_files" | while read -r f; do
    [ -f "$f" ] || continue
    # -i: tidak peduli huruf besar/kecil. False positive yang lolos pola
    # disaring oleh grep -vEi di bawahnya.
    grep -niHE "$aws_key|$private_key|$assignment" "$f" 2>/dev/null \
      | grep -vEi 'your[_-]?|xxx|change[_-]?me|changeme|<[a-z_]+>|contoh|example|dummy|_local\b|placeholder' \
      || true
  done)

  if [ -n "$hits" ]; then
    echo "secret: kemungkinan credential ikut ter-commit:"
    echo "$hits" | sed 's/^/  /'
    echo ""
    echo "Kalau ini benar credential, jangan dikanakan. Kalau ini false positive,"
    echo "perbaiki pola di .githooks/pre-commit lalu commit lagi."
    exit 1
  fi
fi

# --- 3. backend: vet + build ---------------------------------------------
#
# Subshell ( ... ) supaya `cd` tidak bocor ke pemerikahan berikutnya.

if [ -n "$(staged | grep '^backend/' || true)" ]; then
  echo "=> go vet + go build (backend)"
  (
    cd "$root/backend"
    go vet ./...
    go build ./...
  )
fi

# --- 4. frontend: type check ---------------------------------------------

if [ -n "$(staged | grep '^frontend/' || true)" ]; then
  echo "=> type-check (frontend)"
  (
    cd "$root/frontend"
    npm run build >/dev/null
  )
fi

echo "Pre-commit checks passed."
