# Nilai non-secret. Sesuaikan dengan domain dan kapasitas production.
APP_ENV=production
APP_NAME=paymentreceipt-v2
APP_BASE_URL=https://receipt.example.com
APP_TRUSTED_PROXIES=10.0.0.0/8
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_MAX_REQUEST_BODY=2097152
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s
DB_STATEMENT_CACHE_MODE=describe
AUTH_ISSUER=paymentreceipt-v2
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=168h
AUTH_COOKIE_NAME=pr_access_token
AUTH_REFRESH_COOKIE_NAME=pr_refresh_token
AUTH_COOKIE_DOMAIN=receipt.example.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_ARGON2_MEMORY=19456
AUTH_ARGON2_TIME=2
AUTH_ARGON2_THREADS=1
AUTH_ARGON2_KEY_LEN=32
AUTH_ARGON2_SALT_LEN=16
LOG_LEVEL=info
LOG_FORMAT=json
AI_BASE_URL=https://provider.example.com/v1
AI_MODEL_RECEIPT=gemini-3.8-flash-high
AI_TIMEOUT=60s
AI_MAX_REQUEST_BODY=10485760

# Secret berikut WAJIB diinjeksi oleh secret manager/orchestrator, bukan disimpan
# dalam image, repository, atau file environment yang ikut deployment:
# DB_URL=postgres://USER:PASSWORD@HOST:5432/paymentreceipt_v2?sslmode=verify-full
# AUTH_JWT_SECRET=<minimal 32 random bytes>
# AI_API_KEY=<provider API key, opsional bila fitur AI dimatikan>
